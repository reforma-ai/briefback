{
  "name": "@reforma/briefback",
  "version": "2.0.2",
  "description": "An opinionated workflow for shipping production-ready changes with coding agents.",
  "author": "Reforma, Inc. <dev@reforma.ai>",
  "type": "module",
  "bin": {
    "briefback": "bin/briefback.js"
  },
  "files": [
    "assets",
    "bin",
    "skills",
    "plugin.json",
    ".claude-plugin",
    "BRIEFBACK.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "node -e \"if (process.env.CI === 'true' || process.env.SKIP_GIT_HOOKS === '1') process.exit(0); require('child_process').execSync('bunx simple-git-hooks', {stdio:'inherit'})\"",
    "build": "bun build src/bin.ts --target=node --outfile=bin/briefback.js --external skills --external @clack/prompts",
    "typecheck": "tsc --noEmit",
    "changeset": "bunx @changesets/cli",
    "version-packages": "bunx @changesets/cli version && node scripts/sync-plugin-versions.mjs",
    "release": "bunx @changesets/cli publish",
    "test": "bun test",
    "validate:skills": "gh skill publish --dry-run",
    "prepublishOnly": "node scripts/sync-plugin-versions.mjs && bun run typecheck && bun run test && bun run build"
  },
  "simple-git-hooks": {
    "commit-msg": "bunx --no-install commitlint --edit \"$1\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reforma-ai/briefback.git"
  },
  "homepage": "https://github.com/reforma-ai/briefback#readme",
  "bugs": "https://github.com/reforma-ai/briefback/issues",
  "keywords": [
    "agent-skills",
    "coding-agents",
    "cursor",
    "claude-code",
    "codex"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "skills": "1.5.23"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "chore",
          "refactor",
          "docs",
          "test",
          "ci",
          "perf",
          "revert"
        ]
      ],
      "type-case": [
        2,
        "always",
        "lower-case"
      ],
      "type-empty": [
        2,
        "never"
      ],
      "subject-empty": [
        2,
        "never"
      ],
      "subject-min-length": [
        1,
        "always",
        4
      ],
      "body-max-line-length": [
        1,
        "always",
        250
      ],
      "subject-case": [
        2,
        "never",
        [
          "pascal-case",
          "upper-case"
        ]
      ]
    }
  }
}
